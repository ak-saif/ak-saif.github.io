cat("\nAll outputs (CSV + PNG) saved to:", normalizePath(out_dir), "\n")
## -----------------------------------------------------------------------------
## 4b. CFR BY STATE AND YEAR + HEATMAP
## -----------------------------------------------------------------------------
# CFR = Deaths / Cases * 100. Undefined (NA) where a state had 0 cases that year.
state_year_cfr <- je_long %>%
mutate(CFR = if_else(Cases > 0, Deaths / Cases * 100, NA_real_))
# Save as a long table and as a wide State x Year table
write.csv(state_year_cfr, file.path(out_dir, "state_year_cfr_long.csv"), row.names = FALSE)
state_year_cfr %>%
dplyr::select(State, year, CFR) %>%
mutate(CFR = round(CFR, 1)) %>%
pivot_wider(names_from = year, values_from = CFR) %>%
write.csv(file.path(out_dir, "state_year_cfr_wide.csv"), row.names = FALSE)
# Heatmap (same state order as the cases heatmap; states with no cases at all are dropped)
p5b <- state_year_cfr %>%
filter(State %in% heat_order) %>%
mutate(State = factor(State, levels = rev(heat_order)),
year_lab = if_else(year %in% incomplete_years,
paste0(year, "*"), as.character(year))) %>%
ggplot(aes(x = year_lab, y = State, fill = CFR)) +
geom_tile(color = "white") +
geom_text(aes(label = if_else(is.na(CFR), "", sprintf("%.0f", CFR))),
size = 2.6, color = "black") +
scale_fill_viridis_c(option = "magma", direction = -1, na.value = "grey90",
limits = c(0, 100), name = "CFR (%)") +
