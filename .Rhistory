# Let's define simple probabilities
P_BagI  <- 0.5
P_BagII <- 0.5
# Bag I: 5 Red, 3 Blue (out of 8)
P_Red_given_BagI  <- 5/8
P_Blue_given_BagI <- 3/8
# Bag II: 2 Red, 6 Blue (out of 8)
P_Red_given_BagII  <- 2/8
P_Blue_given_BagII <- 6/8
# Print them
cat("P(Red|Bag I):", P_Red_given_BagI, "\n")
cat("P(Red|Bag II):", P_Red_given_BagII, "\n")
# P(Red) = P(BagI)*P(Red|BagI) + P(BagII)*P(Red|BagII)
P_Red <- (P_BagI * P_Red_given_BagI) + (P_BagII * P_Red_given_BagII)
# P(Red) = P(BagI)*P(Red|BagI) + P(BagII)*P(Red|BagII)
P_Red <- (P_BagI * P_Red_given_BagI) + (P_BagII * P_Red_given_BagII)
cat("P(Red):", P_Red, "\n")   # should be 7/16 = 0.4375
# P(Blue) = 1 - P(Red), or compute directly
P_Blue <- (P_BagI * P_Blue_given_BagI) + (P_BagII * P_Blue_given_BagII)
cat("P(Blue):", P_Blue, "\n")  # should be 9/16 = 0.5625
# Sanity check - should sum to 1
cat("Sum check:", P_Red + P_Blue, "\n")
==============
# P(Bag I | Red) = [P(BagI) * P(Red|BagI)] / P(Red)
P_BagI_given_Red <- (P_BagI * P_Red_given_BagI) / P_Red
cat("P(Bag I | Red):", P_BagI_given_Red, "\n")   # should be 5/7 ≈ 0.714
# P(Bag II | Blue) = [P(BagII) * P(Blue|BagII)] / P(Blue)
P_BagII_given_Blue <- (P_BagII * P_Blue_given_BagII) / P_Blue
cat("P(Bag II | Blue):", P_BagII_given_Blue, "\n") # should be 2/3 ≈ 0.667
# Bonus: build a simple reusable Bayes function
bayes_theorem <- function(prior, likelihood, total_prob) {
posterior <- (prior * likelihood) / total_prob
return(posterior)
}
# Test the function
bayes_theorem(P_BagI, P_Red_given_BagI, P_Red)
bags <- c("Bag I", "Bag II")
prior_probs <- c(P_BagI, P_BagII)
posterior_probs_given_red <- c(P_BagI_given_Red, 1 - P_BagI_given_Red)
# Combine into a data frame for plotting
library(ggplot2)
df <- data.frame(
Bag = rep(bags, 2),
Probability = c(prior_probs, posterior_probs_given_red),
Type = rep(c("Prior", "Posterior (after seeing Red)"), each = 2)
)
ggplot(df, aes(x = Bag, y = Probability, fill = Type)) +
geom_bar(stat = "identity", position = "dodge") +
labs(title = "Prior vs Posterior Belief About Which Bag Was Chosen",
y = "Probability") +
theme_minimal()
a_prior <- 2
b_prior <- 2
# Suppose we toss the coin 10 times and observe 7 Heads, 3 Tails
heads <- 7
tails <- 3
# Posterior for Beta-Binomial is simply:
a_posterior <- a_prior + heads
b_posterior <- b_prior + tails
cat("Posterior distribution: Beta(", a_posterior, ",", b_posterior, ")\n")
# Plot Prior vs Posterior
x <- seq(0, 1, length.out = 100)
prior_curve <- dbeta(x, a_prior, b_prior)
posterior_curve <- dbeta(x, a_posterior, b_posterior)
plot(x, posterior_curve, type = "l", col = "blue", lwd = 2,
ylab = "Density", xlab = "Probability of Heads",
main = "Prior vs Posterior Belief About Coin Bias")
lines(x, prior_curve, col = "red", lwd = 2, lty = 2)
legend("topleft", legend = c("Posterior", "Prior"),
col = c("blue", "red"), lty = c(1,2), lwd = 2)
