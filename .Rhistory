ggsave(file.path(out_dir, "fig5b_heatmap_cfr_state_year.png"), p5b,
width = 8, height = 9, dpi = 200)
#13/10/2026
## =============================================================================
## 9. ADVANCED MODELS — ZINB, Mixed-effects NB, Clustering, BYM2, RF/XGBoost
## Install once:
## install.packages(c("glmmTMB","DHARMa","cluster","factoextra","dendextend",
##                     "spdep","CARBayesST","randomForest","xgboost","vip"))
## =============================================================================
library(glmmTMB)
library(DHARMa)
library(cluster)
library(factoextra)
library(dendextend)
library(spdep)
library(CARBayesST)
library(randomForest)
library(xgboost)
library(vip)
model_dir <- file.path(out_dir, "models")
dir.create(model_dir, showWarnings = FALSE)
## Model dataset: use ALL years with real Cases/Deaths (drop fully-NA rows),
## but flag partial years so you can exclude them from inference if you want.
model_df <- je_long %>%
filter(!is.na(Cases)) %>%
mutate(
State       = factor(State),
year_c      = year - min(year),          # centered year, helps convergence
is_partial  = year %in% incomplete_years,
Deaths      = if_else(is.na(Deaths), 0L, as.integer(Deaths)),
Cases       = as.integer(Cases)
)
## -----------------------------------------------------------------------------
## 9.1  ZERO-INFLATED NEGATIVE BINOMIAL (ZINB) — replaces lm(Cases ~ year)
## -----------------------------------------------------------------------------
# Count part: NB trend in cases over year, varying by state baseline.
# Zero part: probability a state-year has structurally zero cases, modeled by
#            state (some states basically never report JE).
zinb_model <- glmmTMB(
Cases ~ year_c + (1 | State),
ziformula = ~ (1 | State),
family = nbinom2,
data = model_df
)
cat("\n=== ZINB model summary ===\n")
print(summary(zinb_model))
# Dispersion / goodness-of-fit check via simulated residuals (DHARMa)
zinb_resid <- simulateResiduals(zinb_model)
png(file.path(model_dir, "zinb_diagnostics.png"), width = 900, height = 450)
plot(zinb_resid)
dev.off()
# Incidence rate ratio per year (exponentiate the year coefficient)
zinb_irr <- exp(fixef(zinb_model)$cond["year_c"])
cat(sprintf("\nZINB: cases change by a factor of %.3f per year (count part)\n", zinb_irr))
saveRDS(zinb_model, file.path(model_dir, "zinb_model.rds"))
## -----------------------------------------------------------------------------
## 9.2  MIXED-EFFECTS NEGATIVE BINOMIAL — robustness check (no zero-inflation)
## -----------------------------------------------------------------------------
nb_mixed <- glmmTMB(
Cases ~ year_c + (1 | State),
family = nbinom2,
data = model_df
)
cat("\n=== Mixed-effects NB model summary ===\n")
print(summary(nb_mixed))
# Compare ZINB vs plain mixed NB — lower AIC/BIC wins
model_comparison <- AIC(zinb_model, nb_mixed)
cat("\n=== Model comparison (AIC) — lower is better ===\n")
print(model_comparison)
write.csv(as.data.frame(model_comparison), file.path(model_dir, "aic_comparison.csv"))
# State-level random-effect estimates: which states run persistently
# above/below the national baseline, after accounting for the year trend
state_effects <- ranef(nb_mixed)$cond$State %>%
tibble::rownames_to_column("State") %>%
rename(random_intercept = `(Intercept)`) %>%
arrange(desc(random_intercept))
print(state_effects)
write.csv(state_effects, file.path(model_dir, "state_random_effects.csv"), row.names = FALSE)
p9a <- state_effects %>%
mutate(State = fct_reorder(State, random_intercept)) %>%
ggplot(aes(x = random_intercept, y = State)) +
geom_col(fill = "#2c5f8a") +
labs(title = "State-level random effects (Mixed NB model)",
subtitle = "Positive = persistently above national baseline burden",
x = "Random intercept (log scale)", y = NULL) +
theme_minimal(base_size = 11)
ggsave(file.path(model_dir, "fig9a_state_random_effects.png"), p9a,
width = 7, height = 8, dpi = 500)
saveRDS(nb_mixed, file.path(model_dir, "nb_mixed_model.rds"))
## -----------------------------------------------------------------------------
## 9.3  CLUSTERING — group states by case trajectory shape
## -----------------------------------------------------------------------------
# Build a State x Year matrix of cases (complete years only, for a fair shape
# comparison), standardized per state so clustering reflects SHAPE of the
# trend, not just magnitude.
traj_wide <- je_complete %>%
dplyr::select(State, year, Cases) %>%
pivot_wider(names_from = year, values_from = Cases, values_fill = 0) %>%
filter(rowSums(across(-State)) > 0)   # drop states with zero cases throughout
traj_matrix <- traj_wide %>% dplyr::select(-State) %>% as.matrix()
rownames(traj_matrix) <- traj_wide$State
traj_scaled <- t(scale(t(traj_matrix)))   # z-score each state's own trajectory
## --- k-means ---
set.seed(42)
# Pick k with the elbow/silhouette method
png(file.path(model_dir, "fig9b_kmeans_elbow.png"), width = 700, height = 450)
print(fviz_nbclust(traj_scaled, kmeans, method = "silhouette", k.max = min(8, nrow(traj_scaled) - 1)))
dev.off()
k_chosen <- 7   # <-- adjust after looking at fig9b_kmeans_elbow.png
km <- kmeans(traj_scaled, centers = k_chosen, nstart = 50)
cluster_assign <- tibble(State = rownames(traj_scaled), kmeans_cluster = factor(km$cluster))
print(cluster_assign %>% arrange(kmeans_cluster))
write.csv(cluster_assign, file.path(model_dir, "kmeans_clusters.csv"), row.names = FALSE)
# Plot each cluster's trajectories together
traj_long_z <- as.data.frame(traj_scaled) %>%
tibble::rownames_to_column("State") %>%
pivot_longer(-State, names_to = "year", values_to = "z_cases") %>%
mutate(year = as.integer(year)) %>%
left_join(cluster_assign, by = "State")
## Custom 3-1-3 layout (3 top, 1 centered middle, 3 bottom) for k = 7 clusters
library(patchwork)
cluster_ids <- sort(unique(traj_long_z$kmeans_cluster))
year_breaks <- sort(unique(traj_long_z$year))
make_cluster_plot <- function(cl) {
traj_long_z %>%
filter(kmeans_cluster == cl) %>%
ggplot(aes(x = year, y = z_cases, group = State, color = kmeans_cluster)) +
geom_line(alpha = 0.6) +
geom_point(size = 1) +
scale_x_continuous(breaks = year_breaks) +
labs(title = paste("Cluster", cl), x = "Year", y = "Std. cases") +
theme_minimal(base_size = 10) +
theme(legend.position = "none",
axis.text.x = element_text(angle = 45, hjust = 1))
}
cluster_plots <- lapply(cluster_ids, make_cluster_plot)
design <- "
ABC
#D#
EFG
"
p9b <- wrap_plots(cluster_plots, design = design) +
plot_annotation(title = "State case trajectories grouped by k-means cluster (k = 7)")
ggsave(file.path(model_dir, "fig9c_kmeans_trajectories.png"), p9b,
width = 10, height = 9, dpi = 500)
## --- Hierarchical clustering (dendrogram — useful alongside k-means) ---
d <- dist(traj_scaled, method = "euclidean")
hc <- hclust(d, method = "ward.D2")
png(file.path(model_dir, "fig9d_hclust_dendrogram.png"),
width = 2700, height = 1500, res = 300)   # same aspect ratio, 300 dpi now
dend <- as.dendrogram(hc) %>% set("branches_k_color", k = k_chosen) %>% set("labels_cex", 0.7)
plot(dend, main = "Hierarchical clustering of state case trajectories")
dev.off()
hc_assign <- tibble(State = rownames(traj_scaled),
hclust_cluster = factor(cutree(hc, k = k_chosen)))
cluster_assign <- cluster_assign %>% left_join(hc_assign, by = "State")
write.csv(cluster_assign, file.path(model_dir, "clusters_kmeans_and_hclust.csv"), row.names = FALSE)
## -----------------------------------------------------------------------------
## 9.4  BAYESIAN SPATIO-TEMPORAL SMOOTHING (BYM2-style, via CARBayesST)
## -----------------------------------------------------------------------------
# NOTE: requires `map_data` (sf object) from Section 7. Run Section 7 first.
# True BYM2 is usually fit in R-INLA; INLA isn't on CRAN, install with:
#   install.packages("INLA", repos = c(getOption("repos"),
#     INLA = "https://inla.r-inla-download.org/R/stable"), dep = TRUE)
# CARBayesST below is a CRAN-only alternative that fits the same family of
# spatio-temporal conditional autoregressive models.
# Build adjacency (neighbors) from the state polygons
# Full map (all boundaries) — used for plotting only
map_full <- map_data
# Data-only subset — used ONLY for adjacency matrix + CAR model fitting
map_complete <- map_data %>% filter(!is.na(State))
nb_list <- poly2nb(map_complete, queen = TRUE)
# Any isolated state (e.g. an island UT with no shared border) breaks CAR
# models — check for and report empty neighbor sets before fitting
n_no_neighbors <- sum(card(nb_list) == 0)
if (n_no_neighbors > 0) {
cat("\nWARNING:", n_no_neighbors, "state(s) have no map neighbors — CARBayesST needs every",
"area connected. Consider merging/dropping island UTs (e.g. Andaman & Nicobar,",
"Lakshadweep) before fitting.\n")
}
W <- nb2mat(nb_list, style = "B", zero.policy = TRUE)
# Long-format panel in the order CARBayesST expects: one row per area per year
st_panel <- je_complete %>%
filter(State %in% map_complete$State) %>%
arrange(year, match(State, map_complete$State))   # must match W's row order
st_panel_model <- st_panel %>%
mutate(Cases = as.integer(Cases),
offset = 1)   # replace with population offset if you have it later
# ST.CARlinear: smooths a linear time trend per area, sharing strength across
# neighboring states — directly analogous to BYM2's spatial smoothing idea,
# extended over time. MCMC-based, so this takes a few minutes.
set.seed(42)
bym_fit <- ST.CARlinear(
formula = Cases ~ 1,
family  = "poisson",
data    = st_panel_model,
W       = W,
burnin  = 5000,
n.sample = 15000,
thin    = 5
)
cat("\n=== CARBayesST spatio-temporal model summary ===\n")
print(bym_fit)
saveRDS(bym_fit, file.path(model_dir, "carbayesst_model.rds"))
# Extract smoothed fitted values and attach back to the map for a cleaner,
# noise-reduced choropleth (compare this to your raw fig7/fig8 maps)
st_panel_model$smoothed_cases <- bym_fit$fitted.values
smoothed_latest <- st_panel_model %>%
filter(year == max(year)) %>%
dplyr::select(State, smoothed_cases)
map_smoothed <- map_complete %>% left_join(smoothed_latest, by = "State")
map_smoothed <- map_full %>% left_join(smoothed_latest, by = "State")
p9e <- ggplot(map_smoothed) +
geom_sf(aes(fill = smoothed_cases), color = "black", linewidth = 0.15) +
scale_fill_viridis_c(option = "inferno", direction = -1, na.value = "grey85",
name = "Smoothed\ncases") +
labs(title = paste0("Spatially Smoothed JE Cases, ", max(complete_years)),
subtitle = "CAR model borrowing strength from neighboring states | Grey = no data") +
theme_void(base_size = 13) +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
ggsave(file.path(model_dir, "fig9e_smoothed_map.png"), p9e, width = 7, height = 7, dpi = 500)
## -----------------------------------------------------------------------------
## 9.5  RANDOM FOREST & XGBOOST — exploratory feature ranking only
## (Not for trend inference — see note at the end. Useful for a quick check
##  on which of {year, state, region} explain the most variance in Cases.)
## -----------------------------------------------------------------------------
while (!is.null(dev.list())) dev.off()   # force-close ALL open graphics devices
rf_df <- model_df %>%
mutate(Region = if_else(State %in% ne_region, "Northeast", "Rest of India")) %>%
dplyr::select(Cases, year, State, Region) %>%
mutate(across(c(State, Region), as.factor))
set.seed(42)
rf_model <- randomForest(Cases ~ year + State + Region, data = rf_df,
ntree = 1000, importance = TRUE)
cat("\n=== Random Forest summary ===\n")
print(rf_model)
while (!is.null(dev.list())) dev.off()   # reset devices before plotting
imp_df <- as.data.frame(importance(rf_model)) %>%
tibble::rownames_to_column("Feature") %>%
arrange(desc(IncNodePurity))
print(imp_df)
p9f <- imp_df %>%
mutate(Feature = fct_reorder(Feature, IncNodePurity)) %>%
ggplot(aes(x = IncNodePurity, y = Feature)) +
geom_col(fill = "#2c5f8a") +
labs(title = "Random Forest — feature importance for predicting Cases",
x = "Importance (IncNodePurity)", y = NULL) +
theme_minimal(base_size = 11)
print(p9f)   # check it shows in the Plots pane
ggsave(file.path(model_dir, "fig9f_rf_importance.png"), p9f,
width = 8, height = 6, dpi = 300)
# XGBoost needs a numeric design matrix
## XGBoost — new-API version (xgboost >= 2.0)
rf_matrix <- model.matrix(Cases ~ year + State + Region, data = rf_df)[, -1]
set.seed(42)
xgb_model <- xgboost(
x = rf_matrix,
y = rf_df$Cases,
nrounds = 200,
max_depth = 4,
learning_rate = 0.1,
objective = "count:poisson",
verbosity = 0
)
print(xgb_model)
xgb_imp <- xgb.importance(model = xgb_model)
print(head(xgb_imp, 10))
write.csv(xgb_imp, file.path(model_dir, "xgboost_importance.csv"), row.names = FALSE)
p9g <- xgb.ggplot.importance(xgb_imp, top_n = 10) +
labs(title = "XGBoost — feature importance for predicting Cases")
ggsave(file.path(model_dir, "fig9g_xgb_importance.png"), p9g, width = 8, height = 6, dpi = 500)
xgb_imp <- xgb.importance(model = xgb_model)
print(head(xgb_imp, 10))
write.csv(xgb_imp, file.path(model_dir, "xgboost_importance.csv"), row.names = FALSE)
p9g <- xgb.ggplot.importance(xgb_imp, top_n = 10) +
labs(title = "XGBoost — feature importance for predicting Cases")
ggsave(file.path(model_dir, "fig9g_xgb_importance.png"), p9g, width = 8, height = 6, dpi = 500)
cat("\nNOTE: RF/XGBoost importance here will almost certainly just say 'State'",
"matters most, because with no covariates beyond year/state/region there's",
"nothing else for a tree model to split on. Use this only as a sanity check",
"that state identity dominates — the ZINB/mixed-NB models above are the",
"right tools for actually reporting a trend or writing it up.\n")
cat("\nAll Section 9 model outputs saved to:", normalizePath(model_dir), "\n")
