pivot_wider(names_from = metric, values_from = value) %>%
arrange(State, year)
auto_incomplete <- je_long %>%
group_by(year) %>%
summarise(any_na_deaths = any(is.na(Deaths)), .groups = "drop") %>%
filter(any_na_deaths) %>%
pull(year)
incomplete_years <- sort(unique(c(partial_years, auto_incomplete)))
complete_years   <- setdiff(sort(unique(je_long$year)), incomplete_years)
cat("Complete years used for trend/stat analysis:", paste(complete_years, collapse = ", "), "\n")
cat("Partial/incomplete years (excluded from trend tests):", paste(incomplete_years, collapse = ", "), "\n")
je_complete <- je_long %>% filter(year %in% complete_years)
## -----------------------------------------------------------------------------
## 2. NATIONAL YEAR-WISE SUMMARY + CFR
## -----------------------------------------------------------------------------
national <- je_long %>%
group_by(year) %>%
summarise(Cases  = sum(Cases,  na.rm = TRUE),
Deaths = sum(Deaths, na.rm = TRUE), .groups = "drop") %>%
mutate(CFR = if_else(year %in% incomplete_years, NA_real_, Deaths / Cases * 100))
print(national)
write.csv(national, file.path(out_dir, "national_year_summary.csv"), row.names = FALSE)
## Figure 1 — National trend (dual axis)
scale_factor <- max(national$Cases, na.rm = TRUE) / max(national$Deaths, na.rm = TRUE)
p1 <- ggplot(national, aes(x = year)) +
geom_line(aes(y = Cases), color = "#2c5f8a", linewidth = 1.1) +
geom_point(aes(y = Cases), color = "#2c5f8a", size = 2.5) +
geom_line(aes(y = Deaths * scale_factor), color = "#c0392b", linewidth = 1.1) +
geom_point(aes(y = Deaths * scale_factor), color = "#c0392b", size = 2.5) +
scale_y_continuous(name = "Cases",
sec.axis = sec_axis(~ . / scale_factor, name = "Deaths")) +
scale_x_continuous(breaks = national$year) +
labs(title = "National JE Cases and Deaths, India",
subtitle = paste0("Blue = Cases (left axis)   |   Red = Deaths (right axis)",
if (length(incomplete_years) > 0)
paste0("   |   Partial year(s): ", paste(incomplete_years, collapse = ", ")) else ""),
x = "Year") +
theme_minimal(base_size = 13) +
theme(axis.title.y.left  = element_text(color = "#2c5f8a"),
axis.title.y.right = element_text(color = "#c0392b"))
ggsave(file.path(out_dir, "fig1_national_trend.png"), p1, width = 8, height = 4.5, dpi = 200)
## Figure 2 — CFR trend (complete years only)
cfr_df <- national %>% filter(!is.na(CFR))
p2 <- ggplot(cfr_df, aes(x = factor(year), y = CFR)) +
geom_col(fill = "#7a5195") +
geom_text(aes(label = sprintf("%.1f%%", CFR)), vjust = -0.4, size = 3.3) +
geom_hline(yintercept = mean(cfr_df$CFR), linetype = "dashed", color = "grey40") +
labs(title = "National Case Fatality Rate (CFR)", x = "Year", y = "CFR (%)") +
theme_minimal(base_size = 13)
ggsave(file.path(out_dir, "fig2_cfr_trend.png"), p2, width = 8, height = 4, dpi = 200)
## -----------------------------------------------------------------------------
## 3. STATE-WISE TOTALS & CFR (complete years only)
## -----------------------------------------------------------------------------
state_totals <- je_complete %>%
group_by(State) %>%
summarise(TotalCases  = sum(Cases,  na.rm = TRUE),
TotalDeaths = sum(Deaths, na.rm = TRUE), .groups = "drop") %>%
mutate(CFR = if_else(TotalCases > 0, TotalDeaths / TotalCases * 100, NA_real_)) %>%
arrange(desc(TotalCases))
print(state_totals)
write.csv(state_totals, file.path(out_dir, "state_totals.csv"), row.names = FALSE)
## Figure 3 — Ranked bar of state totals
top_state <- state_totals$State[1]
p3 <- state_totals %>%
filter(TotalCases > 0) %>%
mutate(highlight = State == top_state,
State = fct_reorder(State, TotalCases)) %>%
ggplot(aes(x = TotalCases, y = State, fill = highlight)) +
geom_col() +
geom_text(aes(label = TotalCases), hjust = -0.15, size = 3) +
scale_fill_manual(values = c(`TRUE` = "#c0392b", `FALSE` = "#2c5f8a"), guide = "none") +
scale_x_continuous(expand = expansion(mult = c(0, 0.12))) +
labs(title = paste0("State-wise Cumulative JE Cases, ",
min(complete_years), "–", max(complete_years)),
x = "Total cases", y = NULL) +
theme_minimal(base_size = 12)
ggsave(file.path(out_dir, "fig3_state_totals.png"), p3, width = 8, height = 7, dpi = 200)
## Figure 4 — Case volume (log) vs CFR
p4 <- state_totals %>%
filter(TotalCases > 0) %>%
ggplot(aes(x = TotalCases, y = CFR, size = TotalDeaths)) +
geom_point(alpha = 0.6, color = "#2c5f8a") +
ggrepel::geom_text_repel(
data = . %>% filter(TotalCases > 150 | CFR > 15),
aes(label = State), size = 3, show.legend = FALSE
) +
scale_x_log10(labels = comma) +
labs(title = "Case Volume vs. Case Fatality Rate by State",
x = "Total cases (log scale)", y = "CFR (%)", size = "Deaths") +
theme_minimal(base_size = 12)
ggsave(file.path(out_dir, "fig4_scatter_cfr.png"), p4, width = 7.5, height = 6, dpi = 200)
## -----------------------------------------------------------------------------
## 4. HEATMAP — State x Year (all years shown; partial year included)
## -----------------------------------------------------------------------------
heat_order <- state_totals %>% filter(TotalCases > 0) %>% pull(State)
p5 <- je_long %>%
filter(State %in% heat_order) %>%
mutate(State = factor(State, levels = rev(heat_order)),
year_lab = if_else(year %in% incomplete_years,
paste0(year, "*"), as.character(year))) %>%
ggplot(aes(x = year_lab, y = State, fill = Cases)) +
geom_tile(color = "white") +
geom_text(aes(label = Cases), size = 2.6, color = "black") +
scale_fill_viridis_c(option = "inferno", direction = -1, na.value = "grey90") +
labs(title = "JE Case Counts by State and Year",
subtitle = "* = partial year", x = "Year", y = NULL, fill = "Cases") +
theme_minimal(base_size = 11) +
theme(panel.grid = element_blank())
ggsave(file.path(out_dir, "fig5_heatmap_state_year.png"), p5, width = 8, height = 9, dpi = 200)
## Figure 6 — Composition: top-5 states' share over time
top5 <- head(state_totals$State, 5)
comp <- je_complete %>%
mutate(group = if_else(State %in% top5, State, "All other states")) %>%
group_by(year, group) %>%
summarise(Cases = sum(Cases, na.rm = TRUE), .groups = "drop") %>%
mutate(group = factor(group, levels = c(top5, "All other states")))
p6 <- ggplot(comp, aes(x = year, y = Cases, fill = group)) +
geom_area(alpha = 0.9, color = "white", linewidth = 0.2) +
scale_fill_viridis_d(option = "turbo") +
labs(title = "Composition of National JE Burden by Top States",
x = "Year", y = "Cases", fill = NULL) +
theme_minimal(base_size = 12)
ggsave(file.path(out_dir, "fig6_composition.png"), p6, width = 8, height = 4.5, dpi = 200)
## -----------------------------------------------------------------------------
## 5. REGIONAL COMPARISON — Northeast vs Rest of India
## -----------------------------------------------------------------------------
ne_region <- c("Assam", "Manipur", "Meghalaya", "Tripura", "Nagaland", "Arunachal Pradesh")
regional <- state_totals %>%
mutate(Region = if_else(State %in% ne_region, "Northeast", "Rest of India")) %>%
group_by(Region) %>%
summarise(Cases = sum(TotalCases), Deaths = sum(TotalDeaths), .groups = "drop") %>%
mutate(CFR = Deaths / Cases * 100)
print(regional)
write.csv(regional, file.path(out_dir, "regional_comparison.csv"), row.names = FALSE)
## -----------------------------------------------------------------------------
## 6. STATISTICAL TESTS
## -----------------------------------------------------------------------------
nat_c <- national %>% filter(year %in% complete_years)
cor_cases_deaths <- cor.test(nat_c$Cases, nat_c$Deaths)
print(cor_cases_deaths)
trend_cases  <- lm(Cases  ~ year, data = nat_c)
trend_deaths <- lm(Deaths ~ year, data = nat_c)
trend_cfr    <- lm(CFR    ~ year, data = nat_c)
cat("\n--- Trend: national Cases over time ---\n");  print(tidy(trend_cases))
cat("\n--- Trend: national Deaths over time ---\n"); print(tidy(trend_deaths))
cat("\n--- Trend: national CFR over time ---\n");    print(tidy(trend_cfr))
spear <- state_totals %>% filter(TotalCases > 0)
cor_volume_cfr <- cor.test(spear$TotalCases, spear$CFR, method = "spearman", exact = FALSE)
print(cor_volume_cfr)
period_compare <- je_complete %>%
mutate(period = case_when(
year %in% 2018:2019 ~ "Pre-COVID (2018-19)",
year %in% 2020:2021 ~ "COVID dip (2020-21)",
TRUE ~ "Post-COVID (2022+)"
)) %>%
group_by(period) %>%
summarise(Cases = sum(Cases, na.rm = TRUE),
n_years = n_distinct(year),
avg_per_year = Cases / n_years, .groups = "drop")
print(period_compare)
